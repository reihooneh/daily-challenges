#!/usr/bin/env php
<?php

declare(strict_types=1);

spl_autoload_register(static function (string $class): void {
    // Only our own classes can ever be loaded: no path is built from input.
    $files = ['Ammonite\\Cli' => 'Cli', 'Ammonite\\Tank' => 'Tank', 'Ammonite\\TankException' => 'Tank', 'Ammonite\\FishGroup' => 'Tank',
        'Ammonite\\Model' => 'Model', 'Ammonite\\Planner' => 'Planner', 'Ammonite\\Report' => 'Report'];
    if (isset($files[$class])) {
        require_once __DIR__ . '/../src/' . $files[$class] . '.php';
    }
});

exit(Ammonite\Cli::run(array_slice($argv, 1), STDOUT, STDERR));
