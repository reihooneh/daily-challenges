{
  "name": "dropstitch",
  "version": "1.0.0",
  "description": "A linter for knitting patterns: finds the row where the stitch count goes wrong before you knit it.",
  "private": true,
  "type": "module",
  "bin": { "dropstitch": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/*.test.js",
    "start": "node dist/src/cli.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
