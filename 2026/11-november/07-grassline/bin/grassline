#!/usr/bin/env php
<?php

declare(strict_types=1);

// grassline: where to aim a biased lawn bowl so it draws to the jack.
foreach (['Physics', 'Shot', 'Log', 'Report', 'Cli'] as $file) {
    require_once __DIR__ . "/../src/$file.php";
}

exit(Grassline\Cli::run(array_slice($argv, 1), STDIN, STDOUT, STDERR));
