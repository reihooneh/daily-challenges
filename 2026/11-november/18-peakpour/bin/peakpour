#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Peakpour: plans which bottles from a wine cellar to open each month, so each is drunk inside its
# drinking window, and works out the fewest bottles a month that achieves it.
# Usage: peakpour CELLAR.txt [--rate N] [--start YYYY-MM]     (CELLAR may be - for standard input)
set -euo pipefail
export LC_ALL=C.UTF-8

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../lib/peakpour.sh
source "$HERE/../lib/peakpour.sh"
# shellcheck source=../lib/report.sh
source "$HERE/../lib/report.sh"

usage() {
  cat <<'TXT'
Usage: peakpour CELLAR.txt [--rate N] [--start YYYY-MM]     (CELLAR may be - for standard input)

  start 2026-11                                   the month to plan from
  rate 4                                          bottles you open a month
  Hunter Valley Semillon 2019, 3, 2026, 2030-06   name, bottles, drink from, drink until

A year alone means January when it starts a window and December when it ends one.
Without a rate, Peakpour plans at the fewest bottles a month that opens everything in time.
Exit codes: 0 every bottle opened in its window, 3 some will pass their best, 2 bad usage or input.
TXT
  exit 2
}

main() {
  local file='' rate='' start=''
  while (($#)); do
    case $1 in
      --rate) (($# >= 2)) || usage; rate=$2; shift 2 ;;
      --start) (($# >= 2)) || usage; start=$2; shift 2 ;;
      -h | --help) usage ;;
      -) [[ -z $file ]] || usage; file=-; shift ;;
      -*) usage ;;
      *) [[ -z $file ]] || usage; file=$1; shift ;;
    esac
  done
  [[ -n $file ]] || usage
  local text
  if [[ $file == - ]]; then
    text=$(head -c $((PP_MAX_BYTES + 1)))
  else
    # A regular file only: no links, folders or devices. The path is never echoed.
    [[ ! -L $file && -f $file && -r $file ]] || pp_die 'the cellar list could not be read (it must be a regular file, not a link)'
    text=$(head -c $((PP_MAX_BYTES + 1)) -- "$file")
  fi
  pp_parse "$text"
  if [[ -n $start ]]; then
    PP_START=$(pp_month "$start" 0) || pp_die '--start is a month like 2026-11'
  fi
  [[ -n $PP_START ]] || pp_die 'say when to start: a "start 2026-11" line, or --start 2026-11'
  if [[ -n $rate ]]; then
    if [[ ! $rate =~ ^[0-9]{1,3}$ ]] || ((10#$rate < 1 || 10#$rate > PP_MAX_RATE)); then
      pp_die "--rate is 1 to $PP_MAX_RATE bottles a month"
    fi
    PP_RATE=$((10#$rate))
  fi
  pp_check_span
  pp_need
  local use=${PP_RATE:-$PP_NEED}
  ((use >= 1)) || use=1
  pp_plan "$use"
  pp_report "$use"
  local w
  for w in "${!PP_NAME[@]}"; do ((PP_MISSED[w] + PP_PAST[w] == 0)) || exit 3; done
  exit 0
}

main "$@"
